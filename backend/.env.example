# Environment (development, staging, production)
ENVIRONMENT=development

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interview_prep_db

# Security & Authentication
SECRET_KEY=change_this_to_a_secure_random_key_in_production
FRONTEND_URL=http://localhost:3000

# Safe Local Development Recovery (Active ONLY when ENVIRONMENT=development)
# Used to verify administrative developer identity when SMTP email delivery is unconfigured
DEV_RECOVERY_KEY=InterviewReadyDev2026!

# Email Delivery / SMTP Configuration (For Production & Real Email Delivery)
# Examples:
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your_email@gmail.com, SMTP_PASSWORD=your_16_digit_app_password
# For Mailtrap (testing): SMTP_HOST=sandbox.smtp.mailtrap.io, SMTP_PORT=2525, SMTP_USER=..., SMTP_PASSWORD=...
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="InterviewReady AI"
SMTP_TLS=true
SMTP_SSL=false
RESET_TOKEN_EXPIRE_MINUTES=15

# Mock Interview & Voice Module Settings
INTERVIEW_AUDIO_DIR=uploads/interview_audio
MAX_AUDIO_SIZE_MB=15

# Optional External AI/LLM Provider API Keys (Leave blank to use built-in offline dataset & rubric engine)
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=auto
